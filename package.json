{
  "name": "memory-reconstruction",
  "version": "0.1.0",
  "description": "Action-Roguelike Metroidvania - Memory Reconstruction",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "ai:benchmark": "node scripts/ai-benchmark.js",
    "ai:replay": "node scripts/ai-replay.js",
    "generate:assets": "node scripts/generate-assets.js",
    "generate:art": "python scripts/generate_art_assets.py"
  },
  "dependencies": {
    "@pixi/filter-bloom": "^5.1.1",
    "@pixi/filter-color-matrix": "^7.4.3",
    "@pixi/sound": "^5.0.0",
    "ecsy": "^0.2.0",
    "pixi.js": "^8.0.0",
    "seedrandom": "^3.0.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/seedrandom": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
